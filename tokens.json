{
  "$schema": "Baseline Design System — design tokens (W3C-style groups)",
  "meta": {
    "system": "Baseline",
    "version": "1.0.0",
    "tiers": ["primitive", "semantic", "component"],
    "note": "Primitives are raw values with no meaning. Semantic tokens carry intent and are the ONLY tier product code and Figma components may reference. Component tokens exist only where a component needs a value the semantic layer does not express."
  },

  "primitive": {
    "color": {
      "neutral": {
        "0":   "#FFFFFF",
        "50":  "#F7F8FA",
        "100": "#EEF0F4",
        "200": "#E1E5EC",
        "300": "#CBD2DC",
        "400": "#98A2B3",
        "500": "#667085",
        "600": "#4B5565",
        "700": "#344054",
        "800": "#1D2536",
        "900": "#121722",
        "950": "#0A0D14"
      },
      "iris": {
        "50":  "#EEEEFF",
        "100": "#E0E1FF",
        "200": "#C6C7FF",
        "300": "#A5A6FB",
        "400": "#8081F2",
        "500": "#6366E4",
        "600": "#4F52D6",
        "700": "#3E40B0",
        "800": "#31338A",
        "900": "#282A6B"
      },
      "green":  { "50": "#ECFDF3", "200": "#ABEFC6", "600": "#079455", "700": "#067647" },
      "amber":  { "50": "#FFFAEB", "200": "#FEDF89", "600": "#DC6803", "700": "#B54708" },
      "red":    { "50": "#FEF3F2", "200": "#FECDCA", "600": "#D92D20", "700": "#B42318" },
      "blue":   { "50": "#EFF8FF", "200": "#B2DDFF", "600": "#1570EF", "700": "#175CD3" }
    },
    "space": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64, "12": 80 },
    "radius": { "none": 0, "sm": 4, "md": 8, "lg": 12, "xl": 16, "full": 9999 },
    "font": {
      "family": {
        "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
        "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
      },
      "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "size":   { "11": 11, "12": 12, "13": 13, "14": 14, "16": 16, "18": 18, "20": 20, "24": 24, "32": 32, "44": 44 }
    }
  },

  "semantic": {
    "bg": {
      "canvas":        { "value": "{neutral.50}",  "use": "The page itself. Never place text directly on it without a surface." },
      "surface":       { "value": "{neutral.0}",   "use": "Default container: cards, panels, inputs, table body." },
      "surface-raised":{ "value": "{neutral.0}",   "use": "Surface that floats: menus, popovers, dropdowns. Pair with elevation-2." },
      "subtle":        { "value": "{neutral.100}", "use": "Inset/quiet zones and hover rows on a surface." },
      "muted":         { "value": "{neutral.200}", "use": "Disabled fills and inactive tracks." },
      "inverse":       { "value": "{neutral.900}", "use": "Dark surface for tooltips and inverse callouts." }
    },
    "text": {
      "primary":   { "value": "{neutral.900}", "use": "Body copy and headings. 15.9:1 on surface." },
      "secondary": { "value": "{neutral.600}", "use": "Supporting text, helper text, labels. 7.1:1 on surface." },
      "tertiary":  { "value": "{neutral.500}", "use": "Metadata, placeholders, captions. 4.8:1 — never below 14px." },
      "disabled":  { "value": "{neutral.400}", "use": "Disabled labels only. Not for readable content." },
      "inverse":   { "value": "{neutral.0}",   "use": "Text on inverse or solid action surfaces." },
      "link":      { "value": "{iris.600}",    "use": "Inline links and text-only navigation." }
    },
    "border": {
      "subtle":  { "value": "{neutral.200}", "use": "Dividers, card outlines, table rules." },
      "default": { "value": "{neutral.300}", "use": "Resting borders on inputs and controls." },
      "strong":  { "value": "{neutral.400}", "use": "Hovered input borders, emphasis." },
      "focus":   { "value": "{iris.500}",    "use": "Focus ring on every interactive element. Never removed." }
    },
    "action": {
      "primary":        { "value": "{iris.600}", "use": "The single primary action per view." },
      "primary-hover":  { "value": "{iris.700}", "use": "Hover state of primary." },
      "primary-active": { "value": "{iris.800}", "use": "Pressed state of primary." },
      "primary-fg":     { "value": "{neutral.0}", "use": "Text/icon on a solid primary surface." },
      "primary-subtle": { "value": "{iris.50}",  "use": "Tinted background for secondary emphasis and selected states." }
    },
    "feedback": {
      "success": { "fg": "{green.700}", "bg": "{green.50}", "border": "{green.200}", "solid": "{green.600}" },
      "warning": { "fg": "{amber.700}", "bg": "{amber.50}", "border": "{amber.200}", "solid": "{amber.600}" },
      "danger":  { "fg": "{red.700}",   "bg": "{red.50}",   "border": "{red.200}",   "solid": "{red.600}" },
      "info":    { "fg": "{blue.700}",  "bg": "{blue.50}",  "border": "{blue.200}",  "solid": "{blue.600}" }
    },
    "elevation": {
      "0": { "value": "none", "use": "Flush with the page. Cards on a tinted background." },
      "1": { "value": "0 1px 2px rgba(10,13,20,.06), 0 1px 3px rgba(10,13,20,.10)", "use": "Resting cards and raised panels." },
      "2": { "value": "0 4px 8px -2px rgba(10,13,20,.10), 0 2px 4px -2px rgba(10,13,20,.06)", "use": "Dropdowns, popovers, hover-lift." },
      "3": { "value": "0 12px 24px -6px rgba(10,13,20,.12), 0 4px 8px -4px rgba(10,13,20,.08)", "use": "Modals and dialogs." },
      "4": { "value": "0 24px 48px -12px rgba(10,13,20,.18)", "use": "Full-screen overlays, command palette." }
    }
  },

  "component": {
    "button": {
      "height-sm": "{space.8}",
      "height-md": 40,
      "height-lg": 48,
      "padding-x-md": "{space.5}",
      "radius": "{radius.sm}",
      "gap-icon": "{space.3}"
    },
    "input": {
      "height-md": 40,
      "padding-x": "{space.4}",
      "radius": "{radius.sm}",
      "border": "{border.default}",
      "border-focus": "{border.focus}"
    }
  }
}
